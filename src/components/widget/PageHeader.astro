---
interface Props {
	number?: string;
	title: string;
	description?: string;
}

const { number, title, description } = Astro.props;
---
<section class="py-16 md:py-24">
	{number && (
		<div class="text-sm font-mono text-[var(--accent-blue)] tracking-wider mb-4">
			/ {number}
		</div>
	)}
	<h1 class="text-[clamp(2.4rem,5vw,5rem)] font-bold leading-[1.05] text-[var(--text-primary)] mb-6">
		{title}
	</h1>
	{description && (
		<p class="text-[var(--text-secondary)] text-lg md:text-xl max-w-2xl leading-relaxed">
			{description}
		</p>
	)}
	<slot name="graphic" />
</section>
