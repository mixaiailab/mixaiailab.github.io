  { project: "自意识调控的分布式CT智能成像方法", competition: "第八届全国大学生生物医学工程创新设计竞赛", award: "三等奖", year: "2023" },
  { project: "基于联邦学习的自由机型CT图像智能重建网络", competition: "第八届全国大学生生物医学工程创新设计竞赛", award: "三等奖", year: "2023" },
  { project: "基于反投影张量特征的CT腹部多脏器智能识别方法", competition: "第二届广东省大学生生物医学工程创新创业设计竞赛", award: "三等奖", year: "2023" },
  { project: "影云共享：新时代CT智能成像先驱者", competition: "第九届中国国际“互联网+”大学生创新创业大赛", award: "银奖", year: "2023" },
  { project: "影云共享：新时代CT智能成像先驱者", competition: "第九届中国国际“互联网+”大学生创新创业大赛广东省分赛", award: "铜奖", year: "2023" },
  { project: "影云共享——新时代CT智能成像先驱者", competition: "第七届“创客广东”生物医药与健康中小企业创新创业大赛高校赛道", award: "三等奖", year: "2023" },
  { project: "影云共享——基于联邦学习的跨机制医疗CT智能成像系统", competition: "挑战杯南方医科大学大学生课外学术科技作品竞赛", award: "优胜奖", year: "2023" },
  { project: "CT Metal Artifact Reduction Challenge (CT-MAR)", competition: "AAPM 2024 Grand Challenge", award: "获奖", year: "2024" },
  { project: "跨机构自适应协作学习的腹部多脏器CT图像分割算法", competition: "第三届广东省大学生生物医学工程创新创业设计竞赛", award: "二等奖", year: "2024" },
  { project: "动态循环联邦学习多机构智能分类方法", competition: "第三届广东省大学生生物医学工程创新创业设计竞赛", award: "三等奖", year: "2024" },
  { project: "光子计数CT探测器失真建模与智能校正方法研究", competition: "第十届全国大学生生物医学工程创新创业竞赛", award: "一等奖", year: "2025" },
  { project: "基于多元数据驱动的多模态学习一体化CT重建网络", competition: "第十届全国大学生生物医学工程创新创业竞赛", award: "二等奖", year: "2025" },
  { project: "基于多视角特征学习与时空感知的数字减影血管造影成像系统", competition: "第十届全国大学生生物医学工程创新创业竞赛", award: "二等奖", year: "2025" },
  { project: "基于多元数据驱动的多模态学习一体化CT重建网络", competition: "第四届广东省生物医学工程创新创业竞赛", award: "二等奖", year: "2025" },
  { project: "基于集成机器学习的口腔癌患者生存预测模型", competition: "第四届广东省生物医学工程创新创业设计竞赛", award: "三等奖", year: "2025" },
  { project: "新型探测器与射线源一体化CT成像系统", competition: "第十一届全国大学生生物医学工程创新创业竞赛", award: "二等奖", year: "2026" },
  { project: "成像机制引导的深硅光子计数CT建模与校正优化方法研究", competition: "第十一届全国大学生生物医学工程创新创业竞赛", award: "三等奖", year: "2026" },
  { project: "OmniDocX 基于大语言模型的多功能胸腹部CT智能助手", competition: "第十一届全国大学生生物医学工程创新创业竞赛", award: "三等奖", year: "2026" },
  { project: "基于专家混合机制的跨机型多任务CT影像协调算法", competition: "第十一届全国大学生生物医学工程创新创业竞赛", award: "三等奖", year: "2026" },
  { project: "桌面CT与3D扫描", competition: "第十一届全国大学生生物医学工程创新创业竞赛", award: "三等奖", year: "2026" },
  { project: "基于流变信号建模的平扫CT计算血流参数图模型", competition: "第十一届全国大学生生物医学工程创新创业竞赛", award: "三等奖", year: "2026" },
  { project: "基于光子计数CT双通道输入的心肌灌注定量", competition: "第五届广东省大学生生物医学工程创新创业竞赛", award: "三等奖", year: "2026" },
];
const awardCols = [
  { title: "2022 – 2023", items: studentAwards.slice(0, 10) },
  { title: "2024 – 2026", items: studentAwards.slice(10) },
];
---

<MainGridLayout title={`科研成果 - ${siteConfig.title}`} description="课题组在低剂量CT成像、光子计数能谱CT、联邦学习医学影像等领域取得了一系列重要成果。">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-4 md:px-9 py-6 relative w-full ">

  <section class="py-16 md:py-24">
    <div class="text-sm font-mono text-[var(--accent-blue)] tracking-wider mb-4">/ 成果</div>
    <h1 class="text-[clamp(2.4rem,5vw,5rem)] font-bold leading-[1.05] text-[var(--text-primary)] mb-6">成果</h1>
    <p class="text-[var(--text-secondary)] text-lg md:text-xl max-w-2xl leading-relaxed mb-16">
      课题组在低剂量CT成像、光子计数能谱CT、联邦学习医学影像等领域取得了一系列重要成果。
    </p>
  </section>

  <!-- 代表性论文 -->
  <section class="pb-24">
    <h2 class="text-2xl font-bold text-[var(--text-primary)] mb-8 flex items-center gap-3">
      <span class="w-1 h-6 bg-[var(--accent-blue-navy)] rounded-full"></span>
      代表性论文
    </h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="min-w-0">
        <div class="flex items-baseline justify-between mb-3">
          <h3 class="font-bold text-[var(--text-primary)] flex items-center gap-2">
            <span class="w-1 h-4 rounded-full bg-[var(--accent-blue-navy)]"></span>
            期刊论文
          </h3>
          <span class="text-xs font-mono text-[var(--text-secondary)]">共 {journalPapers.length} 篇</span>
        </div>
        <div class="space-y-2 overflow-y-auto max-h-[45rem] pr-2 -mr-2">
          {journalPapers.map((p, i) => (
            <div class="bg-[var(--card-bg)] rounded-[10px] p-3 border border-[var(--divider-color)] h-24 overflow-hidden hover:border-[var(--accent-blue)] transition-colors">
              <p class="text-[13px] leading-relaxed line-clamp-3 text-[var(--text-primary)]">
                <span class="font-mono text-[var(--accent-blue-navy)] mr-1.5">{i + 1}.</span>
                {p.split("Dong Zeng").flatMap((seg, k, arr) => [
                  ...(seg ? [seg] : []),
                  ...(k < arr.length - 1 ? [<strong class="font-bold">Dong Zeng</strong>] : []),
                ])}
              </p>
            </div>
          ))}
        </div>
      </div>
      <div class="min-w-0">
        <div class="flex items-baseline justify-between mb-3">
          <h3 class="font-bold text-[var(--text-primary)] flex items-center gap-2">
            <span class="w-1 h-4 rounded-full bg-[var(--accent-blue-light)]"></span>
            会议论文
          </h3>
          <span class="text-xs font-mono text-[var(--text-secondary)]">共 {conferencePapers.length} 篇</span>
        </div>
        <div class="space-y-2 overflow-y-auto max-h-[45rem] pr-2 -mr-2">
          {conferencePapers.map((p, i) => (
            <div class="bg-[var(--card-bg)] rounded-[10px] p-3 border border-[var(--divider-color)] h-24 overflow-hidden hover:border-[var(--accent-blue)] transition-colors">
              <p class="text-[13px] leading-relaxed line-clamp-3 text-[var(--text-primary)]">
                <span class="font-mono text-[var(--accent-blue-navy)] mr-1.5">{i + 1}.</span>
                {p.split("Dong Zeng").flatMap((seg, k, arr) => [
                  ...(seg ? [seg] : []),
                  ...(k < arr.length - 1 ? [<strong class="font-bold">Dong Zeng</strong>] : []),
                ])}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 专利 -->
  <section class="pb-24">
    <h2 class="text-2xl font-bold text-[var(--text-primary)] mb-8 flex items-center gap-3">
      <span class="w-1 h-6 bg-[var(--accent-blue-light)] rounded-full"></span>
      专利
    </h2>
    <div class="space-y-4">
      {patents.map((p) => (
        <div class="bg-[var(--card-bg)] rounded-[12px] p-5 border border-[var(--divider-color)]">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <span class="px-3 py-0.5 rounded-full text-xs font-mono text-[var(--accent-blue-navy)] bg-[var(--accent-blue-navy)]/10">{p.type}</span>
            <span class="text-xs font-mono text-[var(--text-secondary)]">{p.date}</span>
          </div>
          <div>
            <h4 class="font-bold text-[var(--text-primary)] leading-relaxed">{p.title}</h4>
            <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-sm text-[var(--text-secondary)]">
              <span>发明人：{p.inventors}</span>
              <span>专利号：{p.number}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 科研项目 -->
  <section class="pb-24">
    <h2 class="text-2xl font-bold text-[var(--text-primary)] mb-8 flex items-center gap-3">
      <span class="w-1 h-6 bg-[var(--accent-blue)] rounded-full"></span>
      科研项目
    </h2>
    <div class="space-y-4">
      {projects.map((p) => (
        <div class="bg-[var(--card-bg)] rounded-[12px] p-5 border border-[var(--divider-color)]">
          <div class="flex flex-wrap items-center gap-2">
            <span class="px-3 py-0.5 rounded-full text-xs font-mono text-[var(--accent-blue)] bg-[var(--accent-blue)]/10">{p.type}</span>
            <span class="text-xs font-mono text-[var(--text-secondary)]">{p.period}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 学生参赛获奖情况 -->
  <section class="pb-24">
    <h2 class="text-2xl font-bold text-[var(--text-primary)] mb-8 flex items-center gap-3">
      <span class="w-1 h-6 bg-[var(--accent-blue-light)] rounded-full"></span>
      学生参赛获奖情况
    </h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {awardCols.map((col) => (
        <div class="min-w-0">
          <div class="flex items-baseline justify-between mb-3">
            <h3 class="font-bold text-[var(--text-primary)] flex items-center gap-2">
              <span class="w-1 h-4 rounded-full bg-[var(--accent-blue-light)]"></span>
              {col.title}
            </h3>
            <span class="text-xs font-mono text-[var(--text-secondary)]">共 {col.items.length} 项</span>
          </div>
          <div class="space-y-2 overflow-y-auto max-h-[52rem] pr-2 -mr-2">
            {col.items.map((a) => (
              <div class="bg-[var(--card-bg)] rounded-[10px] p-3 border border-[var(--divider-color)] h-28 overflow-hidden hover:border-[var(--accent-blue)] transition-colors">
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="px-2 py-0.5 rounded-full text-[11px] font-mono text-[var(--accent-blue-light)] bg-[var(--accent-blue-light)]/10 whitespace-nowrap">{a.award}</span>
                  <span class="text-[11px] font-mono text-[var(--text-secondary)]">{a.year}</span>
                </div>
                <h4 class="font-bold text-[13px] text-[var(--text-primary)] leading-snug line-clamp-2">{a.project || a.competition}</h4>
                {a.project && <div class="text-[11px] text-[var(--text-secondary)] mt-1 truncate">{a.competition}</div>}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 奖励与荣誉 -->
  <section class="pb-24">
    <h2 class="text-2xl font-bold text-[var(--text-primary)] mb-8 flex items-center gap-3">
      <span class="w-1 h-6 bg-[var(--accent-blue-deep)] rounded-full"></span>
      奖励与荣誉
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6">
      {achievements.map((a) => (
        <div class:list={[a.cols, "bg-[var(--card-bg)] rounded-[18px] overflow-hidden border border-[var(--divider-color)] group hover:border-[var(--accent-blue)] transition-all duration-300"]}>
          {a.image && (
            <div class="zoom-gallery cursor-zoom-in aspect-video bg-[var(--page-bg)] overflow-hidden">
              <img src={a.image} alt={a.title} class="w-full h-full object-cover group-hover:scale-[1.025] transition-transform duration-500" />
            </div>
          )}
          <div class="p-6">
            <div class="flex items-center gap-3 mb-2">
              <span class="px-3 py-1 rounded-full text-xs font-mono" style={{backgroundColor: a.typeColor + '15', color: a.typeColor}}>{a.type}</span>
              {a.year && <span class="text-xs font-mono text-[var(--text-secondary)]">{a.year}</span>}
            </div>
            <h3 class="text-lg font-bold text-[var(--text-primary)]">{a.title}</h3>
            {a.desc && <p class="text-sm text-[var(--text-secondary)] mt-2">{a.desc}</p>}
          </div>
        </div>
      ))}
    </div>
  </section>
        </div>
    </div>
</MainGridLayout>
