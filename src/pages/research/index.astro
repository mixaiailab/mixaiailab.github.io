---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { siteConfig } from "../../config";
import { Icon } from "astro-icon/components";

const directions = [
  {
    id: "01",
    title: "医学CT高分辨成像理论",
    color: "var(--accent-blue)",
    desc: "致力于突破传统解析重建算法的空间分辨率极限，通过精确建模X射线光子与物质的物理相互作用及噪声统计特性，从投影数据中稳定恢复出微米至亚毫米级的精细结构信息。",
    keywords: ["高分辨成像", "解析重建", "物理建模", "亚毫米结构"],
    image: "/images/projects/directions/high-end-ct.png",
  },
  {
    id: "02",
    title: "数模双驱动医学CT成像模型",
    color: "var(--accent-blue-light)",
    desc: "融合物理成像的解析先验与数据驱动的深度学习网络，构建可解释性强且泛化能力优的混合重建模型，以应对稀疏采样和低剂量条件下的图像退化问题。",
    keywords: ["数模融合", "深度学习", "混合重建", "稀疏低剂量"],
    image: "/images/projects/directions/low-dose-ct.png",
  },
  {
    id: "03",
    title: "光子CT定量成像技术",
    color: "var(--accent-blue-navy)",
    desc: "利用光子计数探测器获取多能谱投影数据，实现物质组分（如碘、钙、水）的精确分离与浓度量化，从而提供高分辨率低剂量的光子计数CT专用成像框架",
    keywords: ["光子计数", "能谱成像", "物质分解", "定量成像"],
    image: "/images/projects/directions/photon-ct2.png",
  },
  {
    id: "04",
    title: "灌注CT功能成像技术",
    color: "var(--accent-blue-deep)",
    desc: "通过对动态增强扫描序列的时间-密度曲线进行血流动力学建模，量化组织微循环的灌注参数（血流量、血容量、平均通过时间等），反映器官或病灶的生理功能性状态。",
    keywords: ["灌注CT", "血流动力学", "时间-密度曲线", "功能成像"],
    image: "/images/projects/directions/phantom-ct.png",
  },
  {
    id: "05",
    title: "新一代CT成像理论与技术",
    color: "var(--accent-blue)",
    desc: "以降低剂量，增加成像分辨率为目标的下一代CT成像设备概念设计与制造：分布式CT，静态CT，探源一体静态CT双环CT、静态CT-PET成像系统等。",
    keywords: ["静态CT", "探源一体CT", "双环CT", "静态CT-PET成像系统"],
    image: "/images/projects/directions/next-gen-ct.png",
  },
];

const equipmentList = [
  { name: "东软准光子CT", file: "neusoft-pcct.jpg" },
  { name: "联影 u760 CT", file: "uni-uv760.jpg" },
  { name: "光子计数CT", file: "pcct1.jpg" },
  { name: "光子计数CT（另一视角）", file: "pcct2.jpg" },
  { name: "小动物光子计数成像 1", file: "small-animal-pcct1.jpg" },
  { name: "小动物光子计数成像 2", file: "small-animal-pcct2.jpg" },
  { name: "小动物光子计数成像 3", file: "small-animal-pcct3.jpg" },
  { name: "定量体膜 1", file: "phantom1.jpg" },
  { name: "定量体膜 2", file: "phantom2.png" },
  { name: "项目现场照片", file: "project-photo.jpg" },
];
---

<MainGridLayout title={`研究方向 - ${siteConfig.title}`} description="MiX-AIAI Lab 聚焦医学X射线前沿成像算法与装备，覆盖从物理建模到临床转化的全链条研究。">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-4 md:px-9 py-6 relative w-full ">

  <section class="py-16 md:py-24">
    <div class="text-sm font-mono text-[var(--accent-blue)] tracking-wider mb-4">/ 项目与方向</div>
    <h1 class="text-[clamp(2.4rem,5vw,5rem)] font-bold leading-[1.05] text-[var(--text-primary)] mb-6">研究方向</h1>
    <p class="text-[var(--text-secondary)] text-lg md:text-xl max-w-3xl leading-relaxed mb-16">
      MiX-AIAI Lab 聚焦医学X射线前沿成像算法与装备，覆盖从物理建模到临床转化的全链条研究。
    </p>
  </section>

  <!-- 研究方向 -->
  <section class="pb-24 space-y-16">
    {directions.map((d, i) => (
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class:list={["lg:col-span-6", i % 2 === 1 ? "lg:order-2" : ""]}>
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-full flex items-center justify-center font-mono font-bold text-lg" style={{backgroundColor: d.color + "15", color: d.color}}>
              {d.id}
            </div>
            <h2 class="text-2xl md:text-3xl font-bold text-[var(--text-primary)]">{d.title}</h2>
          </div>
          <p class="text-[var(--text-secondary)] text-lg leading-relaxed mb-4">{d.desc}</p>
          <div class="flex flex-wrap gap-2">
            {d.keywords.map(kw => (
              <span class="px-3 py-1 rounded-full text-xs font-mono border border-[var(--divider-color)] text-[var(--text-secondary)]">{kw}</span>
            ))}
          </div>
        </div>
        <div class:list={["lg:col-span-6", i % 2 === 1 ? "lg:order-1" : ""]}>
          {d.image ? (
            <div class="zoom-gallery cursor-zoom-in rounded-[18px] overflow-hidden border border-[var(--divider-color)] bg-[var(--card-bg)]">
              <img src={d.image} alt={d.title} class="w-full h-auto object-cover" />
            </div>
          ) : (
            <div class="aspect-[4/3] rounded-[18px] bg-gradient-to-br from-[var(--accent-blue)]/5 to-[var(--accent-blue-navy)]/5 border border-[var(--divider-color)] flex items-center justify-center">
              <Icon name="material-symbols:image-outline-rounded" class="text-[4rem] text-[var(--text-secondary)]/20" />
            </div>
          )}
        </div>
      </div>
    ))}
  </section>

  <!-- 科研装备 -->
  <section class="pb-24">
    <h2 class="text-2xl font-bold text-[var(--text-primary)] mb-8 flex items-center gap-3">
      <span class="w-1 h-6 bg-[var(--accent-blue-deep)] rounded-full"></span>
      科研装备
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {equipmentList.map((eq) => (
        <div class="bg-[var(--card-bg)] rounded-[12px] overflow-hidden border border-[var(--divider-color)] group hover:border-[var(--accent-blue)] transition-all duration-300">
          <div class="zoom-gallery cursor-zoom-in aspect-[4/3] bg-[var(--page-bg)] overflow-hidden">
            <img src={"/images/projects/equipment/" + eq.file} alt={eq.name} class="w-full h-full object-cover group-hover:scale-[1.025] transition-transform duration-500" />
          </div>
          <div class="p-3">
            <p class="text-sm font-medium text-[var(--text-primary)] text-center">{eq.name}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
        </div>
    </div>
</MainGridLayout>
