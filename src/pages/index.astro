---
import "@fontsource-variable/jetbrains-mono";
import FullWidthLayout from "../layouts/FullWidthLayout.astro";
import { siteConfig } from "../config";
import { getCollection } from "astro:content";
import { getPostUrlBySlug } from "../utils/url-utils";
import { faculty, masterStudentGroups } from "../data/members";

// 最新动态：取最新 4 条，与新闻页同一数据源
const allPosts = await getCollection("posts", ({ data }) => {
	return data.hidden !== true && (import.meta.env.PROD ? data.draft !== true : true);
});
const recentPosts = allPosts
	.sort((a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime())
	.slice(0, 4);

function formatDate(date: string | number | Date) {
	const d = new Date(date);
	return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;
}

// 团队：展示顺序 马建华 → 曾栋 → 边兆英
const teacherList = ["ma-jianhua", "zeng-dong", "bian-zhaoying"]
	.map((id) => (faculty ?? []).find((f) => f.id === id))
	.filter((f): f is NonNullable<typeof f> => f !== undefined);

const masterCount = (masterStudentGroups ?? []).reduce((s, g) => s + (Array.isArray(g) ? g.length : 0), 0);

// 研究方向（与 /research/ 页同一批真实文案的首页精简版）
const directions = [
	{
		no: "01",
		title: "医学CT高分辨成像理论",
		keywords: ["高分辨成像", "解析重建", "物理建模", "亚毫米结构"],
		desc: "突破传统解析重建算法固有的空间分辨率极限，基于对X射线光子与物质相互作用物理过程及噪声统计特性的精确建模，从原始投影数据中重建微米至亚毫米级的组织精细结构信息。",
	},
	{
		no: "02",
		title: "数模双驱动医学CT重建方法簇",
		keywords: ["数模融合", "深度学习", "混合重建", "稀疏低剂量"],
		desc: "将CT系统的确定性知识作为硬约束植入网络前向传播，以数据驱动的学习模块作为对未知系统偏差与患者特异性变化的软补偿，兼顾零样本可解释性与深度网络的强拟合能力。",
	},
	{
		no: "03",
		title: "光子CT定量成像技术",
		keywords: ["光子计数", "能谱成像", "物质分解", "定量成像"],
		desc: "以光子计数探测器为物理基底，构建从原始信号校正、物理模型构建到高维迭代重建与预临床验证的完整技术链条，为精准医学提供高分辨率、低辐射剂量的专用成像框架。",
	},
	{
		no: "04",
		title: "灌注CT功能成像技术",
		keywords: ["灌注CT", "血流动力学", "时间-密度曲线", "功能成像"],
		desc: "动态监测造影剂在脑组织中的时空分布，定量提取CBF、CBV、MTT、TTP等功能参数，为急性缺血性脑卒中、脑肿瘤及神经退行性疾病的早期诊断提供不可替代的生理信息。",
	},
	{
		no: "05",
		title: "新一代CT成像理论与技术",
		keywords: ["静态CT", "探源一体CT", "双环CT", "静态CT-PET成像系统"],
		desc: "融合新型物理前端设计、非线性逆向求解、多传感器同步触发及多模态联合重建等技术，构建“极低剂量、极高速度、多维信息”的新一代CT成像范式。",
	},
];

// 代表成果（与 /outputs/ 页同一批真实成果的首页精选）
const featuredOutputs = [
	{
		type: "获奖",
		title: "SPIE 最佳论文奖",
		desc: "团队在SPIE医学影像国际会议获最佳论文奖",
		year: "2025",
		image: "/images/achievements/spie-best-paper.png",
	},
	{
		type: "竞赛",
		title: "AAPM MAR Challenge",
		desc: "AAPM金属伪影去除挑战赛获奖",
		year: "2024",
		image: "/images/achievements/aapm-mar-challenge.png",
	},
	{
		type: "获奖",
		title: "18th Fully3D Travel Award",
		desc: "第18届国际Fully3D会议差旅资助奖（Travel Award）",
		image: "/images/achievements/fully3d-travel-award.jpg",
	},
	{
		type: "竞赛",
		title: "互联网+大学生创新创业大赛 银奖",
		desc: "团队学生团队参赛获奖",
		image: "/images/achievements/internet-plus-silver.jpg",
	},
	{
		type: "软著",
		title: "胸部CT扫描区域自动识别软件",
		desc: "医学影像软件著作权",
		image: "/images/achievements/software-copyright-1.jpg",
	},
];

const stats = [
	{ num: String(directions.length).padStart(2, "0"), label: "研究方向" },
	{ num: String(teacherList.length).padStart(2, "0"), label: "指导教师" },
	{ num: String(masterCount), label: "硕士研究生" },
	{ num: String(featuredOutputs.length).padStart(2, "0"), label: "代表成果" },
];
---

<FullWidthLayout title={`${siteConfig.title} · ${siteConfig.subtitle}`} description={siteConfig.subtitle}>
	<!-- swup 容器兼容：主页无目录，保留隐藏节点 -->
	<div id="toc" class="hidden" aria-hidden="true"></div>

	<div class="home">
		<!-- ===== Hero ===== -->
		<section class="hero">
			<canvas id="home-net" aria-hidden="true"></canvas>
			<div class="hero-fade" aria-hidden="true"></div>


			<div class="wrap hero-grid">
				<div>
					<p class="eyebrow reveal">MEDICAL X-RAY ADVANCED IMAGING ALGORITHM AND INSTRUMENTATION LABORATORY</p>
					
					<h1 class="reveal d1">
						<span class="line">shape the</span>
						<span class="line">future of</span>
						<span class="line line-outline">medical imaging</span>
					</h1>
					<p class="hero-sub reveal d2">突破下一代医学成像设备壁垒</p>
					<p class="lead reveal d2">
						医学X射线前沿成像算法与装备实验室（Medical X-ray Advanced Imaging Algorithm and Instrumentation Laboratory，简称MIX‑AIAI Lab）由国家级领军学者马建华教授与南方医科大学曾栋副研究员共同领导，聚焦低剂量高分辨CT成像理论与算法，致力于突破临床辐射剂量与图像质量之间的矛盾，推动国产高端CT装备自主创新。
					</p>
					<div class="hero-meta reveal d2">
						<span class="hud">低剂量高分辨 CT 成像</span>
						<span class="hud">国产高端 CT 自主创新</span>
						<span class="hud">南方医科大学生物医学工程学院</span>
					</div>
					<div class="cta-row reveal d3">
						<a href="/research/" class="btn btn-primary">探索研究方向 <span class="arr">→</span></a>
						<a href="/outputs/" class="btn btn-ghost">查看最新成果</a>
					</div>
				</div>

				<div class="hero-visual reveal d2" aria-hidden="true">
					<div class="scan-frame">
						<img src="/images/hero/ct-hero.png" alt="" class="ct-image" loading="eager" />
					</div>
					<div class="scan-label">
						<span class="dot"></span>下一代 CT 设备 × 先进成像算法 × 前沿成像技术 × 临床一线研究
					</div>
				</div>
			</div>

		</section>

		<!-- ===== 主页横幅（独立区块） ===== -->
		<section class="banner-section" aria-label="主页横幅">
			<div class="wrap">
				<div class="banner-wrap reveal">
					<img src="/images/home/banner2.png" alt="MiX-AIAI Lab 主页横幅" class="banner-img" width="1024" height="434" loading="eager" />
				</div>
			</div>
		</section>

		<!-- ===== 统计 ===== -->
		<section class="stats" aria-label="团队概况">
			<div class="wrap stats-inner">
				{stats.map((s, i) => (
					<div class:list={["stat reveal", i > 0 ? `d${i}` : ""]}>
						<div class="num"><em>{s.num}</em></div>
						<div class="lb">{s.label}</div>
					</div>
				))}
			</div>
		</section>

		<!-- ===== 研究方向 ===== -->
		<section class="section" id="home-research">
			<div class="wrap">
				<div class="sec-head reveal">
					<span class="no">01</span>
					<h2>研究<span class="out">方向</span></h2>
					<span class="en">RESEARCH DIRECTIONS</span>
				</div>
				<div class="dir-list">
					{directions.map((d, i) => (
						<a href="/research/" class:list={["dir-row reveal", i > 0 ? `d${i % 3}` : ""]} style={`--c:${i % 2 === 0 ? "var(--accent-blue)" : "var(--home-red)"}`}>
							<span class="dir-no">{d.no}</span>
							<div class="dir-main">
								<h3>{d.title}</h3>
								<div class="chips">
									{d.keywords.map((k) => <span class="chip">{k}</span>)}
								</div>
								<p>{d.desc}</p>
							</div>
							<span class="dir-arrow">→</span>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- ===== 最新动态 ===== -->
		<section class="section section-alt" id="home-news">
			<div class="wrap">
				<div class="sec-head reveal">
					<span class="no">02</span>
					<h2>最新<span class="out">动态</span></h2>
					<span class="en">LATEST UPDATES</span>
				</div>
				<div class="news-grid">
					{recentPosts.map((post, i) => (
						<a href={getPostUrlBySlug(post.slug)} class:list={["news-card reveal", i > 0 ? `d${i}` : ""]}>
							<div class="nc-head">
								<span class:list={["nc-tag", i % 2 === 0 ? "tag-blue" : "tag-red"]}>{post.data.category ?? "动态"}</span>
								<span class="nc-date">{formatDate(post.data.published)}</span>
							</div>
							<h3>{post.data.title}</h3>
							{post.data.description && <p>{post.data.description}</p>}
							<span class="nc-more">阅读全文 →</span>
						</a>
					))}
				</div>
				<div class="section-more reveal">
					<a href="/news/">查看全部新闻 →</a>
				</div>
			</div>
		</section>

		<!-- ===== 代表成果 ===== -->
		<section class="section" id="home-outputs">
			<div class="wrap">
				<div class="sec-head reveal">
					<span class="no">03</span>
					<h2>代表<span class="out">成果</span></h2>
					<span class="en">SELECTED OUTPUTS</span>
				</div>
				<div class="out-grid">
					{featuredOutputs.map((o, i) => (
						<a href="/outputs/" class:list={["out-tile reveal", i > 0 ? `d${i % 3}` : ""]} style={`--tc:${i % 2 === 0 ? "var(--accent-blue)" : "var(--home-red)"}`}>
							{o.image ? (
								<div class="out-vis">
									<img src={o.image} alt={o.title} loading="lazy" />
								</div>
							) : (
								<div class="out-vis out-vis-placeholder">
									<span class="ph-type">{o.type}</span>
									<span class="ph-mark">MIX‑AIAI</span>
								</div>
							)}
							<div class="out-body">
								<div class="out-meta">
									<span class:list={["out-type", i % 2 === 0 ? "type-blue" : "type-red"]}>{o.type}</span>
									{o.year && <span>{o.year}</span>}
								</div>
								<h3>{o.title}</h3>
								{o.desc && <p>{o.desc}</p>}
							</div>
						</a>
					))}
				</div>
				<div class="section-more reveal">
					<a href="/outputs/">查看全部成果 →</a>
				</div>
			</div>
		</section>

		<!-- ===== 团队 ===== -->
		<section class="section section-alt" id="home-team">
			<div class="wrap">
				<div class="sec-head reveal">
					<span class="no">04</span>
					<h2>核心<span class="out">团队</span></h2>
					<span class="en">PEOPLE</span>
				</div>
				<div class="team-grid">
					{teacherList.map((t, i) => (
						<a href={`/members/${t.id}/`} class:list={["t-card reveal", i > 0 ? `d${i}` : ""]}>
							<div class="t-photo">
								{t.photo ? <img src={t.photo} alt={`${t.name}的照片`} loading="lazy" /> : <span class="t-fallback">MIX</span>}
								<span class="t-badge">{i === 0 ? "PI" : t.badge ?? "教师"}</span>
							</div>
							<div class="t-info">
								<h3>{t.name}</h3>
								<span class="t-title">{t.title}</span>
								{t.research && <span class="t-research">{t.research}</span>}
							</div>
						</a>
					))}
				</div>
				<div class="students-note reveal">
					 <span class="cnt">20 + 名成员</span>
					<p>课题组目前有博士生2名和硕士生20余名，来自不同院校与专业，组成高精尖人才梯队</p>
					<a href="/members/" class="btn btn-ghost">查看全部成员 →</a>
				</div>
			</div>
		</section>
	</div>
</FullWidthLayout>

<style>
	.home {
		--home-red: #8b1a1a;
	}

	:global(.dark) .home {
		--home-red: #d94848;
	}

	.home {
		overflow: hidden;
	}

	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		min-height: calc(100vh - 7rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: clamp(2rem, 5vw, 5rem) 0;
	}

	.hero canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
	}

	.hero-fade {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: radial-gradient(120% 100% at 18% 18%, transparent 0%, var(--page-bg) 82%);
		pointer-events: none;
	}

	.banner-section {
		padding: clamp(1rem, 2vw, 2rem) 0 clamp(2rem, 4vw, 3.5rem);
	}

	.banner-wrap {
		width: 100%;
		border-radius: 1.25rem;
		overflow: hidden;
		background: #ffffff;
		border: 1px solid var(--divider-color);
	}

	.banner-img {
		width: 100%;
		height: auto;
		display: block;
	}

	.hero-grid {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: 1fr 1.05fr;
		gap: clamp(2rem, 4vw, 4rem);
		align-items: center;
	}

	.eyebrow {
		font-family: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		color: var(--text-secondary);
		text-transform: uppercase;
		margin-bottom: 1.5rem;
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.eyebrow::before {
		content: "";
		width: 2.25rem;
		height: 2px;
		background: var(--accent-blue);
		flex: none;
	}

	.hero-logo {
		height: clamp(3.25rem, 6vw, 5rem);
		width: auto;
		margin-bottom: 1.75rem;
		filter: drop-shadow(0 10px 24px rgba(0, 0, 0, 0.12));
	}

	.hero h1 {
		font-family: "Microsoft YaHei", "微软雅黑", "Noto Sans SC Variable", "Noto Sans SC", "PingFang SC", system-ui, sans-serif;
		font-weight: 900;
		line-height: 1.04;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		margin-bottom: 1.2rem;
	}

	.hero .line {
		display: block;
		font-size: clamp(2.6rem, 7vw, 6rem);
		color: var(--text-primary);
	}

	.hero .line-outline {
		font-size: clamp(2.6rem, 7vw, 6rem);
		line-height: 1.04;
		color: transparent;
		-webkit-text-stroke: 2px var(--accent-blue);
		text-stroke: 2px var(--accent-blue);
		margin-top: 0.2rem;
	}

	.hero-sub {
		font-family: "Microsoft YaHei", "微软雅黑", "Noto Sans SC Variable", "Noto Sans SC", "PingFang SC", system-ui, sans-serif;
		font-weight: 700;
		font-size: clamp(1.05rem, 2.2vw, 1.5rem);
		letter-spacing: 0.14em;
		color: var(--home-red);
		margin-bottom: 1.1rem;
	}

	.lead {
		color: var(--text-secondary);
		font-size: clamp(0.98rem, 1.25vw, 1.08rem);
		line-height: 1.9;
		max-width: 58ch;
		margin-bottom: 1.6rem;
	}

	.hero-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-bottom: 2.1rem;
	}

	.hud {
		font-family: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		color: var(--text-secondary);
		border: 1px solid var(--divider-color);
		border-radius: 999px;
		padding: 0.42rem 0.9rem;
		background: var(--card-bg);
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.85rem 1.7rem;
		border-radius: 999px;
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, background 0.2s ease;
	}

	.btn .arr {
		transition: transform 0.2s ease;
	}

	.btn:hover .arr {
		transform: translateX(4px);
	}

	.btn-primary {
		background: var(--accent-blue);
		color: #fff;
	}

	.btn-primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 14px 30px color-mix(in srgb, var(--accent-blue) 35%, transparent);
	}

	.btn-ghost {
		border: 1px solid var(--divider-color);
		background: var(--card-bg);
		color: var(--text-primary);
	}

	.btn-ghost:hover {
		border-color: var(--home-red);
		color: var(--home-red);
		transform: translateY(-2px);
	}

	/* Hero 右侧 CT 图 */
	.hero-visual {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.scan-frame {
		position: relative;
		width: 100%;
		max-width: 820px;
	}

	.ct-image {
		width: 100%;
		height: auto;
		display: block;
	}

	.scan-label {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-family: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		color: var(--text-secondary);
	}

	.scan-label .dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--home-red);
		animation: blink 2s step-end infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0.25;
		}
	}

	/* ---------- 统计 ---------- */
	.stats {
		border-block: 1px solid var(--divider-color);
	}

	.stats-inner {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
	}

	.stat {
		padding: 1.9rem 1.5rem;
		border-left: 1px solid var(--divider-color);
	}

	.stat:first-child {
		border-left: none;
	}

	.stat .num {
		font-family: "Microsoft YaHei", "微软雅黑", "Noto Sans SC Variable", "Noto Sans SC", "PingFang SC", system-ui, sans-serif;
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 800;
		line-height: 1;
		color: var(--text-primary);
	}

	.stat .num em {
		font-style: normal;
		color: var(--accent-blue);
	}

	.stat .lb {
		font-family: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		color: var(--text-secondary);
		text-transform: uppercase;
		margin-top: 0.5rem;
	}

	/* ---------- 区块通用 ---------- */
	.section {
		padding: clamp(4rem, 8vw, 7rem) 0;
	}

	.sec-head {
		display: flex;
		align-items: baseline;
		gap: 1.1rem;
		margin-bottom: clamp(2.2rem, 4vw, 3.5rem);
	}

	.sec-head .no {
		font-family: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.82rem;
		color: var(--home-red);
