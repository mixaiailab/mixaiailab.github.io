<script>
	document.documentElement.classList.add("home-js");

	type NetPoint = { x: number; y: number; vx: number; vy: number; r: number; c: string };

	(() => {
		const net = document.getElementById("home-net") as HTMLCanvasElement;
		if (!net || net.dataset.init) {
			return;
		}
		net.dataset.init = "1";
		const ctx = net.getContext("2d") as CanvasRenderingContext2D;
		if (!ctx) {
			return;
		}
		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const DPR = Math.min(window.devicePixelRatio || 1, 2);
		const palette: string[] = ["#315CFF", "#315CFF", "#D94848"];
		let W = 0;
		let H = 0;
		let points: NetPoint[] = [];
		let lineColor = "rgba(102,100,95,0.22)";
		let mouse = { x: -9999, y: -9999 };

		function readTheme() {
			const root = document.documentElement;
			const cs = getComputedStyle(root);
			const blue = (cs.getPropertyValue("--accent-blue") || "#315CFF").trim();
			const red = root.classList.contains("dark") ? "#D94848" : "#8B1A1A";
			palette[0] = blue;
			palette[1] = blue;
			palette[2] = red;
			lineColor = root.classList.contains("dark")
				? "rgba(164,163,158,0.22)"
				: "rgba(102,100,95,0.22)";
		}

		function resize() {
			const parent = net.parentElement;
			if (!parent) {
				return;
			}
			const rect = parent.getBoundingClientRect();
			W = rect.width;
			H = rect.height;
			net.width = Math.round(W * DPR);
			net.height = Math.round(H * DPR);
			ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
			const count = Math.min(70, Math.round((W * H) / 16000));
			points = [];
			for (let i = 0; i < count; i++) {
				points.push({
					x: Math.random() * W,
					y: Math.random() * H,
					vx: (Math.random() - 0.5) * 0.3,
					vy: (Math.random() - 0.5) * 0.3,
					r: Math.random() * 1.6 + 0.8,
					c: palette[Math.floor(Math.random() * palette.length)]!,
				});
			}
		}

		function draw() {
			ctx.clearRect(0, 0, W, H);
			const link = 130;
			for (let i = 0; i < points.length; i++) {
				const p = points[i];
				for (let j = i + 1; j < points.length; j++) {
					const q = points[j];
					const dx = p.x - q.x;
					const dy = p.y - q.y;
					const d2 = dx * dx + dy * dy;
					if (d2 < link * link) {
						const a = 1 - d2 / (link * link);
						ctx.strokeStyle = lineColor;
						ctx.globalAlpha = a;
						ctx.lineWidth = 1;
						ctx.beginPath();
						ctx.moveTo(p.x, p.y);
						ctx.lineTo(q.x, q.y);
						ctx.stroke();
					}
				}
			}
			ctx.globalAlpha = 1;
			for (let k = 0; k < points.length; k++) {
				const n = points[k];
				ctx.fillStyle = n.c;
				ctx.beginPath();
				ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
				ctx.fill();
			}
		}

		function step() {
			for (let i = 0; i < points.length; i++) {
				const p = points[i];
				const mdx = p.x - mouse.x;
				const mdy = p.y - mouse.y;
				const md2 = mdx * mdx + mdy * mdy;
				if (md2 < 170 * 170 && md2 > 0.01) {
					const f = (1 - Math.sqrt(md2) / 170) * 0.3;
					p.vx += (mdx / Math.sqrt(md2)) * f;
					p.vy += (mdy / Math.sqrt(md2)) * f;
				}
				p.vx *= 0.985;
				p.vy *= 0.985;
				p.x += p.vx;
				p.y += p.vy;
				if (p.x < 0 || p.x > W) {
					p.vx *= -1;
					p.x = Math.max(2, Math.min(W - 2, p.x));
				}
				if (p.y < 0 || p.y > H) {
					p.vy *= -1;
					p.y = Math.max(2, Math.min(H - 2, p.y));
				}
			}
			draw();
			requestAnimationFrame(step);
		}

		readTheme();
		resize();
		window.addEventListener("resize", resize);
		window.addEventListener("mousemove", (e) => {
			const parent = net.parentElement;
			if (!parent) {
				return;
			}
			const rect = parent.getBoundingClientRect();
			mouse.x = e.clientX - rect.left;
			mouse.y = e.clientY - rect.top;
		});
		new MutationObserver(() => {
			readTheme();
			for (let i = 0; i < points.length; i++) {
				points[i]!.c = palette[Math.floor(Math.random() * palette.length)]!;
			}
		}).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
		if (reduce) {
			draw();
		} else {
			step();
		}
	})();

	// 滚动显现
	const io: IntersectionObserver | null =
		"IntersectionObserver" in window
			? new IntersectionObserver(
					(entries) => {
						entries.forEach((en) => {
							if (en.isIntersecting && io) {
								en.target.classList.add("in");
								io.unobserve(en.target);
							}
						});
					},
					{ threshold: 0.1 },
				)
			: null;
	document.querySelectorAll(".reveal").forEach((el) => {
		if (io) {
			io.observe(el);
		} else {
			el.classList.add("in");
		}
	});
</script>
